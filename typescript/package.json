{
  "name": "norma-sdk",
  "version": "4.0.0-dev.2",
  "private": false,
  "description": "TypeScript SDK for Norma",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norma-platform/norma-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/norma-platform/norma-sdk/issues"
  },
  "homepage": "https://github.com/norma-platform/norma-sdk",
  "keywords": [
    "norma",
    "ai-agents",
    "guardrails",
    "sdk",
    "typescript",
    "safety"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/openai-agents.d.ts",
        "default": "./dist/openai-agents.js"
      },
      "require": {
        "types": "./dist/openai-agents.d.cts",
        "default": "./dist/openai-agents.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "make release-check",
    "release:dry-run": "make release-check",
    "prepack": "pnpm run build",
    "check": "make check"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@openai/agents": "0.20.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@9.0.0",
  "peerDependencies": {
    "@openai/agents": "0.20.0"
  },
  "peerDependenciesMeta": {
    "@openai/agents": {
      "optional": true
    }
  },
  "_norma_notice": "Modified for Norma."
}
